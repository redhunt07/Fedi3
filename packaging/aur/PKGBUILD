# Maintainer: RedHunt07 <redhunt07@tutanota.com>
pkgname=fedi3-bin
pkgver=0.12.0
pkgrel=1
pkgdesc='Self-hosted ActivityPub client with P2P sync, chat and calls'
arch=('x86_64')
url='https://github.com/redhunt07/Fedi3'
license=('AGPL-3.0-only')
depends=('glib2' 'gtk3' 'libsecret' 'webkit2gtk-4.1' 'gstreamer' 'gst-plugins-base-libs' 'libpulse' 'jsoncpp' 'libx11' 'libxcb' 'libxshmfence' 'libdrm' 'mesa' 'wayland')
provides=('fedi3')
conflicts=('fedi3' 'fedi3-git')
options=('!strip')
source=("fedi3-${pkgver}.AppImage::https://github.com/redhunt07/Fedi3/releases/download/v${pkgver}/Fedi3-linux-x86_64.AppImage"
        "LICENSE::https://raw.githubusercontent.com/redhunt07/Fedi3/v${pkgver}/LICENSE")
sha256sums=('95d91567cf0725dea37a1dedc100100a2924e7fa1b91aadb1c29884485451611'
            'd8a6cc31abc16b6748c7a21f21611f5a1ec33f67d22ca23d7da1c19b95496bee')

package() {
  cd "$srcdir"
  chmod +x "fedi3-${pkgver}.AppImage"
  "./fedi3-${pkgver}.AppImage" --appimage-extract >/dev/null

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/opt/fedi3"
  cp -a squashfs-root/. "$pkgdir/opt/fedi3/"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/fedi3" <<'WRAPPER'
#!/bin/sh
exec /opt/fedi3/AppRun "$@"
WRAPPER
  chmod 755 "$pkgdir/usr/bin/fedi3"

  install -Dm644 squashfs-root/fedi3.desktop "$pkgdir/usr/share/applications/fedi3.desktop"
  install -Dm644 squashfs-root/fedi3.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/fedi3.png"
}
