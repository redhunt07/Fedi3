#!/bin/sh
# The Linux runner (app/linux/runner/main.cc) selects the Mesa EGL vendor and
# the zink/llvmpipe driver on NVIDIA before GTK starts, so this launcher only
# forwards explicit user choices. Flutter 3.50.0 draws a half-window shift on
# the NVIDIA proprietary EGL driver; the engine fix ships in Flutter 3.50.1.
export LD_LIBRARY_PATH="/app/lib:/app/fedi3/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"
export LP_NUM_THREADS="${LP_NUM_THREADS:-4}"
exec /app/fedi3/fedi3 --enable-software-rendering "$@"
