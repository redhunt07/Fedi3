# Development template only. Replace every dev-* secret before public deployment.
# Set the real DNS name and configure TLS as described in docs/deploy_relay.md.
FEDI3_DOMAIN=localhost
FEDI3_RELAY_ADMIN_TOKEN=dev-admin-token-1234567890
FEDI3_RELAY_TELEMETRY_TOKEN=
FEDI3_RELAY_DB_DRIVER=postgres
FEDI3_RELAY_PG_DB=fedi3_relay
FEDI3_RELAY_PG_USER=fedi3
FEDI3_RELAY_PG_PASSWORD=dev-postgres-password-change-me
FEDI3_RELAY_DB_URL=postgres://fedi3:dev-postgres-password-change-me@postgres:5432/fedi3_relay
FEDI3_RELAY_MEDIA_BACKEND=local
FEDI3_RELAY_ALLOW_SELF_REGISTER=false
FEDI3_RELAY_MESH_ENABLE=true
FEDI3_RELAY_MEILI_MASTER_KEY=dev-meili-master-key-change-me
FEDI3_RELAY_MEILI_API_KEY=dev-meili-master-key-change-me
FEDI3_RELAY_MEILI_URL=http://meilisearch:7700
TURN_REALM=localhost
TURN_USER=relay
TURN_PASS=dev-turn-password-change-me
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
