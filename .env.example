# FEDI3 relay configuration
# Copy to .env and replace every REPLACE_ME. Never commit .env.

# ------------------------------------------------------------------ Mode
# Compose profiles select which components run. scripts/install_server.sh
# writes this value automatically. Manual examples:
#   full server:        relay,p2p,caddy
#   relay only:         relay,caddy
#   P2P only:           p2p
#   behind YunoHost:    relay,p2p  (nginx terminates TLS, no Caddy)
# Optional add-ons: turn (coturn), search (Meilisearch).
COMPOSE_PROFILES=relay,p2p,caddy
# caddy = this stack terminates TLS; external = an existing proxy (YunoHost)
# owns 80/443 and forwards to 127.0.0.1:8787.
FEDI3_EDGE_PROXY=caddy

# ------------------------------------------------------------------ Identity
# Public hostname of the relay (used for actor ids, webfinger and TLS).
FEDI3_DOMAIN=relay.example.org
FEDI3_RELAY_BASE_DOMAIN=relay.example.org
FEDI3_RELAY_PUBLIC_URL=https://relay.example.org
# Bind address INSIDE the container. Keep 0.0.0.0 so the proxy can reach it;
# never publish the port directly on the host.
FEDI3_RELAY_BIND=0.0.0.0:8787

# ------------------------------------------------------------------ Secrets
# Must be at least 32 characters. Generate with: openssl rand -hex 32
FEDI3_RELAY_ADMIN_TOKEN=REPLACE_ME_AT_LEAST_32_CHARS
# Optional separate token for /metrics.prom (defaults to the admin token).
FEDI3_RELAY_TELEMETRY_TOKEN=
FEDI3_RELAY_ALLOW_SELF_REGISTER=false

# ------------------------------------------------------------------ Proxying
# Only enable when the relay is behind a proxy that OVERWRITES X-Forwarded-For.
FEDI3_RELAY_TRUST_PROXY_HEADERS=true
FEDI3_RELAY_IP_ALLOWLIST=
FEDI3_RELAY_IP_DENYLIST=

# ------------------------------------------------------------------ Relay mesh
# Relays can be linked (POST /admin/peers) to route users hosted elsewhere.
# How often to refresh peer user directories (seconds).
FEDI3_RELAY_PEER_SYNC_SECS=60
# Maximum relay-to-relay hops before giving up.
FEDI3_RELAY_PEER_MAX_HOPS=3

# ------------------------------------------------------------------ Database
# sqlite | postgres
FEDI3_RELAY_DB_DRIVER=postgres
FEDI3_RELAY_DB=./data/relay.db
# Optional full URL override. Leave empty for the Compose PostgreSQL service:
# PG_USER/PG_PASSWORD/PG_DB below are used once, with URL-safe encoding.
FEDI3_RELAY_DB_URL=
FEDI3_RELAY_DB_BUSY_TIMEOUT_MS=5000
FEDI3_RELAY_DB_CACHE_KB=20000
FEDI3_RELAY_DB_SYNC=NORMAL
FEDI3_RELAY_PG_DB=fedi3_relay
FEDI3_RELAY_PG_USER=fedi3
FEDI3_RELAY_PG_PASSWORD=REPLACE_ME
FEDI3_RELAY_PG_POOL_MAX_SIZE=16
FEDI3_RELAY_PG_POOL_WAIT_MS=5000
FEDI3_RELAY_PG_POOL_CREATE_TIMEOUT_MS=3000
FEDI3_RELAY_PG_POOL_RECYCLE_TIMEOUT_MS=30000
FEDI3_RELAY_PG_POOL_QUEUE_MODE=fifo
FEDI3_RELAY_PG_INIT_RETRIES=30
FEDI3_RELAY_PG_INIT_BACKOFF_MS=500

# ------------------------------------------------------------------ Redis (optional)
# Used for distributed rate limiting. If empty, an in-process limiter is used.
FEDI3_RELAY_REDIS_URL=
FEDI3_RELAY_REDIS_PREFIX=fedi3
FEDI3_RELAY_REDIS_POOL_SIZE=8

# ------------------------------------------------------------------ Rate limits (per minute)
FEDI3_RELAY_RL_ADMIN_PER_MIN=60
FEDI3_RELAY_RL_REGISTER_PER_MIN=20
FEDI3_RELAY_RL_TUNNEL_PER_MIN=60
FEDI3_RELAY_RL_INBOX_PER_MIN=120
FEDI3_RELAY_RL_FORWARD_PER_MIN=240
FEDI3_RELAY_NOISY_BACKOFF_BASE_SECS=2
FEDI3_RELAY_NOISY_BACKOFF_MAX_SECS=60

# ------------------------------------------------------------------ HTTP behaviour
FEDI3_RELAY_MAX_BODY_BYTES=67108864
FEDI3_RELAY_MAX_INBOX_FANOUT=20
FEDI3_RELAY_MAX_INFLIGHT_PER_USER=4
FEDI3_RELAY_TUNNEL_TIMEOUT_SECS=30
FEDI3_RELAY_HSTS_MAX_AGE_SECS=31536000
FEDI3_RELAY_CSP="default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
FEDI3_RELAY_HTTP_TIMEOUT_SECS=30
FEDI3_RELAY_HTTP_CONNECT_TIMEOUT_SECS=10
FEDI3_RELAY_HTTP_POOL_IDLE_TIMEOUT_SECS=90
FEDI3_RELAY_HTTP_POOL_MAX_IDLE_PER_HOST=8

# ------------------------------------------------------------------ Media
# local | webdav | s3
FEDI3_RELAY_MEDIA_BACKEND=local
FEDI3_RELAY_MEDIA_DIR=/data/media
FEDI3_RELAY_MEDIA_PREFIX=media
FEDI3_RELAY_MEDIA_S3_BUCKET=
FEDI3_RELAY_MEDIA_S3_REGION=
FEDI3_RELAY_MEDIA_S3_ENDPOINT=
FEDI3_RELAY_MEDIA_S3_ACCESS_KEY=
FEDI3_RELAY_MEDIA_S3_SECRET_KEY=
FEDI3_RELAY_MEDIA_S3_PATH_STYLE=true
FEDI3_RELAY_MEDIA_WEBDAV_BASE_URL=
FEDI3_RELAY_MEDIA_WEBDAV_USERNAME=
FEDI3_RELAY_MEDIA_WEBDAV_PASSWORD=
FEDI3_RELAY_MEDIA_WEBDAV_BEARER_TOKEN=

# ------------------------------------------------------------------ Search
# db | meili
FEDI3_RELAY_SEARCH_BACKEND=db
FEDI3_RELAY_SEARCH_TOTAL_MODE=approx
FEDI3_RELAY_SEARCH_CACHE_TTL_SECS=10
FEDI3_RELAY_SEARCH_CACHE_MAX=512
FEDI3_RELAY_MEILI_URL=http://meilisearch:7700
FEDI3_RELAY_MEILI_API_KEY=
FEDI3_RELAY_MEILI_MASTER_KEY=
FEDI3_RELAY_MEILI_TIMEOUT_SECS=10
FEDI3_RELAY_MEILI_NOTES_INDEX=relay_notes
FEDI3_RELAY_MEILI_USERS_INDEX=relay_users
FEDI3_RELAY_MEILI_BATCH_MAX=200
FEDI3_RELAY_MEILI_FLUSH_MS=400
FEDI3_RELAY_MEILI_QUEUE_MAX=10000

# ------------------------------------------------------------------ Federation jobs
FEDI3_RELAY_SPOOL_MAX_ROWS_PER_USER=500
FEDI3_RELAY_SPOOL_TTL_SECS=604800
FEDI3_RELAY_SPOOL_FLUSH_BATCH=50
FEDI3_RELAY_SYNC_INTERVAL_SECS=300
FEDI3_RELAY_SYNC_LIMIT=500
FEDI3_RELAY_MOVE_NOTICE_TTL_SECS=604800
FEDI3_RELAY_MOVE_NOTICE_FANOUT_INTERVAL_SECS=60
FEDI3_RELAY_OUTBOX_INDEX_INTERVAL_SECS=600
FEDI3_RELAY_OUTBOX_INDEX_PAGES=5
FEDI3_RELAY_OUTBOX_INDEX_PAGE_LIMIT=50
FEDI3_RELAY_PEER_DIRECTORY_TTL_DAYS=30
FEDI3_RELAY_SEED_RELAYS=
# Shared relay directory used when FEDI3_RELAY_SEED_RELAYS is empty.
# Comma-separated URLs; empty disables directory discovery.
FEDI3_RELAY_DIRECTORY_URLS=
FEDI3_RELAY_TELEMETRY_INTERVAL_SECS=900
FEDI3_RELAY_TELEMETRY_PEERS_LIMIT=5000
FEDI3_RELAY_TELEMETRY_USERS_LIMIT=5000

# ------------------------------------------------------------------ Retention and quotas
# 0 means unlimited for the byte quotas.
FEDI3_RELAY_ADMIN_AUDIT_TTL_SECS=7776000
FEDI3_RELAY_NOTES_TTL_SECS=2592000
FEDI3_RELAY_PEER_REGISTRY_TTL_SECS=2592000
FEDI3_RELAY_REGISTRY_TTL_SECS=7776000
FEDI3_RELAY_USER_DIRECTORY_TTL_SECS=2592000
FEDI3_RELAY_INBOX_DEDUPE_TTL_SECS=3600
FEDI3_RELAY_MEDIA_MAX_BYTES_PER_USER=1073741824
FEDI3_RELAY_SPOOL_MAX_BYTES_PER_USER=67108864
# Tunnel forward: how long to wait for the user's core before spooling.
FEDI3_RELAY_FORWARD_SEND_TIMEOUT_MS=250
# Allow actor/key fetches from loopback and private ranges. Off by default
# because remote keyId URLs pointing at 127.0.0.1 are an SSRF vector.
# Set to 1 only when the relay legitimately federates with local instances.
FEDI3_RELAY_ALLOW_PRIVATE_ACTOR_FETCH=false
# Allow relay-initiated fetches (telemetry, outbox `next`, relay sync) from
# loopback/private addresses. Off by default (SSRF guard). Enable it only when
# the relay federates with instances on the local network.
FEDI3_ALLOW_PRIVATE_REMOTE_FETCH=false

# ------------------------------------------------------------------ Core federation fetches
# The core rejects actor/key/object fetches that resolve to private, loopback,
# link-local or unique-local addresses (SSRF guard). Enable this only for local
# development or LAN-only federation (e.g. two cores on 127.0.0.1).
FEDI3_ALLOW_PRIVATE_ACTOR_FETCH=false

# ------------------------------------------------------------------ WebRTC signalling
FEDI3_RELAY_WEBRTC_SIGNAL_TTL_SECS=300
FEDI3_RELAY_WEBRTC_SIGNAL_MAX_PER_PEER=32
FEDI3_RELAY_WEBRTC_SIGNAL_CLEANUP_INTERVAL_SECS=60

# ------------------------------------------------------------------ TURN (coturn)
TURN_REALM=relay.example.org
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
TURN_USER=relay
TURN_PASS=REPLACE_ME
# Public IP announced to clients behind NAT (required for coturn to work).
TURN_EXTERNAL_IP=

# ------------------------------------------------------------------ P2P infrastructure node
FEDI3_P2P_INFRA_HOST=0.0.0.0
FEDI3_P2P_INFRA_PORT=4001
FEDI3_P2P_INFRA_MULTIADDRS=
FEDI3_P2P_INFRA_PEER_ID=
FEDI3_P2P_INFRA_PEER_ID_FILE=/data/p2p_infra_peer_id

# ------------------------------------------------------------------ Optional outbound proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Public circuit relay addresses, e.g. /ip4/203.0.113.1/tcp/4001
FEDI3_P2P_EXTERNAL_ADDR=
# Multiaddrs of existing P2P infrastructure nodes used to join the Fedi3 DHT.
# Example: /ip4/203.0.113.10/tcp/4001/p2p/12D3KooW...
FEDI3_P2P_BOOTSTRAP=

# Circuit relay capacity (Fedi3 frames can exceed libp2p's 128 KiB default).
FEDI3_P2P_RELAY_MAX_CIRCUITS=64
FEDI3_P2P_RELAY_MAX_CIRCUITS_PER_PEER=8
FEDI3_P2P_RELAY_MAX_CIRCUIT_BYTES=16777216
FEDI3_P2P_RELAY_MAX_CIRCUIT_SECS=900
# A client retries a closed reservation after a relay restart. Keep room for
# those retries; the reservation rate limiter refills continuously.
FEDI3_P2P_RELAY_MAX_RESERVATIONS_PER_PEER=8

# Optional mobile push gateway (disabled without BOTH settings). The gateway
# adapts opaque wakeups to UnifiedPush/APNs; it must coalesce and restrict endpoints.
# Keep credentials in the deployment secret store, never in the client directory.
FEDI3_RELAY_PUSH_GATEWAY_URL=
FEDI3_RELAY_PUSH_GATEWAY_TOKEN=
# Optional private JSON file mounted inside the relay (/data is persisted).
# Each operator has its own urls, username and credential; see docs/network_resilience.md.
FEDI3_RELAY_TURN_POOL_FILE=
# When no pool file is mounted, the relay derives the ICE pool from these
# values (coturn on the same host) and publishes it to authenticated clients.
# Leave the credential empty to disable automatic TURN provisioning.
FEDI3_RELAY_TURN_URLS=
FEDI3_RELAY_TURN_PORT=3478
FEDI3_RELAY_TURN_USERNAME=relay
FEDI3_RELAY_TURN_CREDENTIAL=
# Optional gateway capabilities; only advertise providers implemented by it.
FEDI3_RELAY_PUSH_PROVIDERS=unifiedpush,apns
# Public P-256 VAPID key (base64url, no padding), matching the gateway private key.
FEDI3_RELAY_PUSH_VAPID_PUBLIC_KEY=
# Signed forward journal: private receipts and public commitments expire together.
FEDI3_RELAY_RECEIPT_TTL_SECS=2592000
FEDI3_RELAY_RECEIPT_MAX_ROWS=100000
